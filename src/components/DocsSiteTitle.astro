<a href="/" class="site-title sl-flex" aria-label="Engram home">
	<img src="/logo-navbar.png" alt="Engram logo" class="brand-logo" />
	
</a>

<style>
	@layer starlight.core {
		.site-title {
			align-items: center;
			gap: 0.65rem;
			text-decoration: none;
			white-space: nowrap;
			min-width: 0;
		}

		.site-mark {
			height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
			width: auto;
			flex-shrink: 0;
			object-fit: contain;
		}

		.brand-logo {
			height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
			width: auto;
			flex-shrink: 0;
			object-fit: contain;
		}

		.brand-wordmark {
			font-family: 'Geist', system-ui, sans-serif;
			font-size: 1.05rem;
			font-weight: 700;
			letter-spacing: -0.03em;
			color: var(--sl-color-white);
			overflow: hidden;
			text-overflow: ellipsis;
		}

		.site-title:hover .brand-wordmark,
		.site-title:focus-visible .brand-wordmark {
			color: var(--engram-accent-high);
		}
