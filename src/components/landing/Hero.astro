---
// Hero section — the flagship entrance
---

<section class="hero noise-overlay" id="hero">
  <!-- Radial glow orb -->
  <div class="hero__orb" aria-hidden="true"></div>
  <div class="hero__orb hero__orb--secondary" aria-hidden="true"></div>

  <!-- Grid texture -->
  <div class="hero__grid" aria-hidden="true"></div>

  <div class="hero__content container">
    <div class="hero__left reveal">
      <div class="hero__badge eyebrow reveal reveal-delay-1">
        <span class="hero__badge-dot" aria-hidden="true"></span>
        <span data-i18n="hero.badge">Single binary &mdash; Zero dependencies</span>
      </div>

      <h1 class="display-xl hero__headline reveal reveal-delay-2">
        <span class="hero__headline-line hero__headline-line--primary" data-i18n="hero.headline1">Give your agent</span>
        <span class="hero__headline-line hero__headline-line--secondary gradient-text" data-i18n="hero.headline2">a brain.</span>
      </h1>

      <p class="hero__sub reveal reveal-delay-3" data-i18n="hero.sub">
        Persistent memory for AI coding agents. Agent-agnostic, SQLite + FTS5,
        a single Go binary. Works with Claude Code, Gemini CLI, Codex, VS Code and more.
      </p>

      <div class="hero__actions reveal reveal-delay-4">
        <a href="/getting-started/installation/" class="btn btn-primary btn-lg">
          <span data-i18n="hero.cta.primary">Install Engram</span>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 1v10M3 7l5 5 5-5M1 13h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="/getting-started/" class="btn btn-secondary btn-lg" data-i18n="hero.cta.secondary">
          Read the docs
        </a>
      </div>

      <div class="hero__install reveal reveal-delay-5">
        <div class="hero__install-bar">
          <span class="hero__install-prompt">$</span>
          <code class="hero__install-cmd">brew install gentleman-programming/tap/engram</code>
          <button class="hero__copy-btn" id="copy-install" aria-label="Copy install command" data-i18n-attr="aria-label:hero.copy">
            <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
              <rect x="4" y="4" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
              <path d="M3 3V2a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
              <path d="M1 5h2M1 7h2M1 9h2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.4"/>
            </svg>
          </button>
        </div>
      </div>

      <p class="hero__platforms reveal reveal-delay-6" data-i18n-html="hero.platforms">
        Also available for <a href="/getting-started/installation/">Windows &amp; Mac/Linux</a>
      </p>

      <div class="hero__visual-row reveal">
        <div class="hero__visual-image-wrap">
          <img src="/engram-logo.png" alt="Engram elephant mascot" class="hero__visual-img" id="engram-logo-img" />
        </div>
        <div class="hero__logotype" aria-hidden="true">
          <img
            id="logotype-img"
            src="/engram-text.png"
            alt="Engram logotype"
            class="hero__logotype-img"
          />
          <div class="hero__logotype-glow" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: 3rem;
    overflow: hidden;
    background: var(--bg-base);
  }

  .hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    pointer-events: none;
    will-change: transform;
  }

  .hero__orb {
    width: clamp(400px, 50vw, 750px);
    height: clamp(400px, 50vw, 750px);
    top: -20%;
    right: -15%;
    background: radial-gradient(ellipse, rgba(234, 24, 137, 0.18) 0%, rgba(234, 24, 137, 0.04) 50%, transparent 70%);
  }

  .hero__orb--secondary {
    width: clamp(300px, 35vw, 500px);
    height: clamp(300px, 35vw, 500px);
    bottom: -10%;
    left: -10%;
    background: radial-gradient(ellipse, rgba(234, 24, 137, 0.09) 0%, transparent 65%);
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black, transparent);
    -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black, transparent);
    pointer-events: none;
    will-change: transform;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: var(--section-py);
    text-align: center;
    
  }

  .hero__left {
    width: 100%;
    max-width: 980px;
    margin-inline: auto;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem;
    background: var(--accent-soft);
    border: 1px solid rgba(234, 24, 137, 0.25);
    border-radius: 999px;
    margin-bottom: 1.5rem;
    
  }

  .hero__badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; box-shadow: 0 0 8px var(--accent); }
    50% { opacity: 0.5; box-shadow: 0 0 3px var(--accent); }
  }

 

  .hero__headline {
    margin-bottom: 1.5rem;
    color: var(--text-primary);
    text-align: center;
  }

  .hero__headline-line {
    display: inline;
  }

  .hero__headline-line--primary {
    margin-right: 0.28ch;
  }

  .hero__sub {
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 2.5rem;
    max-width: 780px;
    margin-inline: auto;
    text-align: center;
  }

  .hero__actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
    
  }

  .hero__install {
    margin-bottom: 1rem;
  }

  .hero__install-bar {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 1rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-secondary);
    max-width: 100%;
    overflow: hidden;
    
  }

  .hero__install-prompt {
    color: var(--accent);
    font-weight: 700;
    flex-shrink: 0;
  }

  .hero__install-cmd {
    color: var(--text-primary);
    font-family: var(--font-mono);
    background: none;
    font-size: 0.8125rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hero__copy-btn {
    flex-shrink: 0;
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.15rem;
    border-radius: 4px;
    transition: color 0.2s, background 0.2s;
    display: flex;
    align-items: center;
  }

  .hero__copy-btn:hover {
    color: var(--accent);
    background: var(--accent-soft);
  }

  .hero__platforms {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .hero__platforms a {
    color: var(--text-secondary);
    border-bottom: 1px solid rgba(255,255,255,0.15);
    transition: color 0.2s, border-color 0.2s;
  }

  .hero__platforms a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* Visual row: image + terminal side by side */
  .hero__visual-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0;
    margin-top: 3rem;
    width: 100%;
  }

  .hero__visual-image-wrap {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
   
    
  }

  .hero__visual-img {
    width: 80%;
    max-width: 280px;
    height: auto;
    border-radius: 12px;
    object-fit: contain;
   
    filter: drop-shadow(0 0 20px rgba(234, 24, 137, 0.2)) drop-shadow(0 8px 24px rgba(0,0,0,0.4));
    transition: filter 0.4s ease;
    margin-bottom: 35px;
    margin-left: 80px;
    z-index: 500;
    cursor: pointer;
    user-select: none;
  }

  .hero__visual-img:hover {
    filter: drop-shadow(0 0 32px rgba(234, 24, 137, 0.4)) drop-shadow(0 8px 24px rgba(0,0,0,0.4));
  }

  @keyframes elephant-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .hero__tagline {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 0.45rem 0.85rem;
    background: rgba(13, 13, 16, 0.85);
    border: 1px solid rgba(234, 24, 137, 0.2);
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: clamp(0.7rem, 1vw, 0.82rem);
    white-space: nowrap;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .hero__tagline-prompt {
    color: var(--accent);
    font-weight: 700;
    flex-shrink: 0;
  }

  .hero__tagline-text {
    color: #e4e4f0;
    letter-spacing: 0.02em;
    min-height: 1.2em;
  }

  .hero__tagline-cursor {
    color: #ea1889;
    animation: blink 1.1s step-end infinite;
    font-size: 0.75em;
    line-height: 1;
  }

  @media (min-width: 768px) {
    .hero__visual-row {
      flex-direction: row;
      align-items: center;
      justify-content: center;
    }

    .hero__visual-image-wrap {
      width: 38%;
      max-width: 320px;
    }

    .hero__visual-img {
      max-width: 320px;
    }
  }

  /* Logotype image replacement */
  .hero__logotype {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 560px;
    /* wipe: fully clipped from the right (invisible) */
    clip-path: inset(0 100% 0 0);
    transition: clip-path 1s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* revealed: negative values expose the drop-shadow area outside the box */
  .hero__logotype.is-visible {
    clip-path: inset(-80px -80px -80px -80px);
  }

  .hero__logotype-img {
    width: 100%;
    min-width: 207px;
    height: auto;
    object-fit: contain;
    filter:
      drop-shadow(0 0 40px rgba(234, 24, 137, 0.35))
      drop-shadow(0 0 80px rgba(234, 24, 137, 0.15))
      drop-shadow(0 16px 40px rgba(0, 0, 0, 0.5));
    opacity: 0;
    transition:
      opacity 0.6s ease 0.25s,
      filter 0.4s ease;
  }

  .hero__logotype.is-visible .hero__logotype-img {
    opacity: 1;
  }

  .hero__logotype-img:hover {
    filter:
      drop-shadow(0 0 56px rgba(234, 24, 137, 0.55))
      drop-shadow(0 0 100px rgba(234, 24, 137, 0.25))
      drop-shadow(0 16px 40px rgba(0, 0, 0, 0.5));
  }

  /* Ambient glow orb beneath the logo */
  .hero__logotype-glow {
    position: absolute;
    inset: 20% 10%;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(234, 24, 137, 0.18) 0%, transparent 70%);
    filter: blur(32px);
    pointer-events: none;
    z-index: -1;
    animation: logotype-breathe 4s ease-in-out infinite;
  }

  @keyframes logotype-breathe {
    0%, 100% { opacity: 0.7; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.08); }
  }

  @media (max-width: 767px) {
    .hero__visual-img {
      width: clamp(70px, 32vw, 140px);
      max-width: 140px;
      margin-left: 0;
      margin-bottom: 5px;
    }

    .hero__logotype {
      max-width: clamp(140px, 44vw, 280px);
    }

    .hero__visual-image-wrap {
      flex-shrink: 1;
    }
  }

  @media (max-width: 900px) {
    .hero__logotype {
      max-width: 100%;
    }
  }

  @media (min-width: 901px) {
    .hero__headline-line {
      display: block;
    }

    .hero__headline-line--primary {
      margin-right: 0;
      white-space: nowrap;
    }
  }
</style>

<script>
  const copyBtn = document.getElementById('copy-install');
  const cmd = 'brew install gentleman-programming/tap/engram';

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(cmd);
      const original = copyBtn.innerHTML;
      copyBtn.innerHTML = `<svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true"><path d="M2.5 8.5l3 3 7-7" stroke="#ea1889" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
      setTimeout(() => { copyBtn.innerHTML = original; }, 2000);
    } catch {}
  });

  // Typewriter effect for elephant tagline
  const taglineEl = document.getElementById('elephant-tagline');
  type LandingLang = 'en' | 'es';
  const phrases = {
    en: 'An elephant never forgets.',
    es: 'Un elefante nunca olvida.'
  };
  const storedLang = localStorage.getItem('engram-landing-lang');
  const currentLang: LandingLang = storedLang === 'es' ? 'es' : 'en';
  let phrase = phrases[currentLang];
  let i = 0;
  let started = false;

  function typeChar() {
    if (!taglineEl || i > phrase.length) return;
    taglineEl.textContent = phrase.slice(0, i);
    i++;
    if (i <= phrase.length) {
      setTimeout(typeChar, 70 + Math.random() * 40);
    }
  }

  // Logotype reveal on enter viewport
  // NOTE: observe the unclipped visual-row parent — the logotype wrapper starts with
  // clip-path: inset(0 100% 0 0) which causes browsers to compute 0% intersection
  // on the img child, so a threshold > 0 would never fire on the img itself.
  const logotypeImg = document.getElementById('logotype-img') as HTMLImageElement | null;
  const logotypeWrapper = logotypeImg?.closest('.hero__logotype') as HTMLElement | null;
  if (logotypeImg) {
    const triggerEl = (logotypeImg.closest('.hero__visual-row') as HTMLElement | null) ?? logotypeImg;
    const logoObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          // Small delay so the elephant animation settles first
          setTimeout(() => logotypeWrapper?.classList.add('is-visible'), 300);
          logoObserver.disconnect();
        }
      });
    }, { threshold: 0.1 });
    logoObserver.observe(triggerEl);
  }

  // Start typing when the element scrolls into view
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        started = true;
        setTimeout(typeChar, 600);
        observer.disconnect();
      }
    });
  }, { threshold: 0.5 });

  if (taglineEl) observer.observe(taglineEl);

  // Elephant click → replay logotype wipe animation
  const elephantImg = document.getElementById('engram-logo-img') as HTMLImageElement | null;
  let replayTimer: ReturnType<typeof setTimeout> | null = null;

  elephantImg?.addEventListener('click', () => {
    if (!logotypeWrapper) return;

    // Cancel any pending replay
    if (replayTimer !== null) {
      clearTimeout(replayTimer);
      replayTimer = null;
    }

    const logotypeImgEl = logotypeWrapper.querySelector('.hero__logotype-img') as HTMLElement | null;

    // 1. Kill transitions so the reset is INSTANT (no 1s reverse-wipe)
    logotypeWrapper.style.transition = 'none';
    if (logotypeImgEl) logotypeImgEl.style.transition = 'none';

    // 2. Remove visible state
    logotypeWrapper.classList.remove('is-visible');

    // 3. Force reflow so browser applies the hidden state before we restore transitions
    void logotypeWrapper.offsetWidth;

    // 4. Restore transitions in the next frame, then trigger the reveal
    requestAnimationFrame(() => {
      logotypeWrapper.style.transition = '';
      if (logotypeImgEl) logotypeImgEl.style.transition = '';
      replayTimer = setTimeout(() => {
        logotypeWrapper.classList.add('is-visible');
        replayTimer = null;
      }, 50);
    });
  });

  window.addEventListener('engram:langchange', (event) => {
    const nextLang = (event as CustomEvent<{ lang?: LandingLang }>).detail?.lang === 'es' ? 'es' : 'en';
    phrase = phrases[nextLang];
    i = 0;
    if (taglineEl) taglineEl.textContent = '';
    if (started) setTimeout(typeChar, 120);
  });
</script>
