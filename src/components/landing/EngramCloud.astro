---
// Engram Cloud — premium product launch section
---

<section class="cloud section noise-overlay" id="engram-cloud">
  <!-- Atmospheric background effects -->
  <div class="cloud__aurora" aria-hidden="true"></div>
  <div class="cloud__orb cloud__orb--1" aria-hidden="true"></div>
  <div class="cloud__orb cloud__orb--2" aria-hidden="true"></div>
  <div class="cloud__grid" aria-hidden="true"></div>

  <!-- Floating particles -->
  <div class="cloud__particles" aria-hidden="true">
    <span class="cloud__particle cloud__particle--1"></span>
    <span class="cloud__particle cloud__particle--2"></span>
    <span class="cloud__particle cloud__particle--3"></span>
    <span class="cloud__particle cloud__particle--4"></span>
    <span class="cloud__particle cloud__particle--5"></span>
    <span class="cloud__particle cloud__particle--6"></span>
  </div>

  <div class="container">

    <!-- Hero area: badge + headline + image -->
    <div class="cloud__hero reveal">
      

      <h2 class="display-xl cloud__headline reveal reveal-delay-1">
        <span class="cloud__headline-line" data-i18n="cloud.headline1">Your memory,</span>
        <span class="cloud__headline-line gradient-text" data-i18n="cloud.headline2">everywhere.</span>
      </h2>

      <p class="cloud__sub reveal reveal-delay-2" data-i18n="cloud.sub">
        Engram Cloud is an opt-in, self-hosted replication layer that syncs your agent's
        memory across machines — with a browser dashboard for your entire team. Local SQLite
        stays the source of truth. Always.
      </p>
    </div>

    <!-- Visual centerpiece: mascot image -->
    <div class="cloud__visual reveal reveal-delay-3">
      <div class="cloud__image-frame">
        <div class="cloud__image-glow" aria-hidden="true"></div>
        <img
          src="/engram-cloude.png"
          alt="Engram Cloud — A Hive Mind of Elephants"
          class="cloud__image"
          width="960"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

   

    <!-- Feature pillars -->
    <div class="cloud__features">
      <div class="card cloud__feature reveal reveal-delay-1">
        <div class="cloud__feature-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ea1889" stroke-width="1.5" stroke-linecap="round">
            <path d="M12 2L2 7l10 5 10-5-10-5z"/>
            <path d="M2 17l10 5 10-5"/>
            <path d="M2 12l10 5 10-5"/>
          </svg>
        </div>
        <h3 class="cloud__feature-title" data-i18n="cloud.feature1.title">Project-scoped replication</h3>
        <p class="cloud__feature-desc" data-i18n-html="cloud.feature1.desc">
          Each sync call is tied to one explicit <code>--project</code>. No surprise data leaks.
          You control exactly what leaves your machine.
        </p>
      </div>

      <div class="card cloud__feature reveal reveal-delay-2">
        <div class="cloud__feature-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ea1889" stroke-width="1.5" stroke-linecap="round">
            <rect x="3" y="3" width="18" height="18" rx="3"/>
            <path d="M3 9h18"/>
            <circle cx="7" cy="6" r="0.8" fill="#ea1889"/>
            <circle cx="10" cy="6" r="0.8" fill="#ea1889"/>
            <circle cx="13" cy="6" r="0.8" fill="#ea1889"/>
            <path d="M7 13h10M7 16.5h6"/>
          </svg>
        </div>
        <h3 class="cloud__feature-title" data-i18n="cloud.feature2.title">Browser dashboard</h3>
        <p class="cloud__feature-desc" data-i18n="cloud.feature2.desc">
          Server-rendered UI for stats, activity, project browser, contributors,
          and admin controls. Your team sees what the agents remember.
        </p>
      </div>

      <div class="card cloud__feature reveal reveal-delay-3">
        <div class="cloud__feature-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ea1889" stroke-width="1.5" stroke-linecap="round">
            <path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"/>
            <path d="M12 8v4l2 2"/>
          </svg>
        </div>
        <h3 class="cloud__feature-title" data-i18n="cloud.feature3.title">Self-hosted, your rules</h3>
        <p class="cloud__feature-desc" data-i18n="cloud.feature3.desc">
          Deploy on your infrastructure — Dokploy, Coolify, Portainer, or bare VPS.
          Official Docker image on GHCR. Linux amd64 + arm64.
        </p>
      </div>

      <div class="card cloud__feature reveal reveal-delay-4">
        <div class="cloud__feature-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ea1889" stroke-width="1.5" stroke-linecap="round">
            <path d="M9 12l2 2 4-4"/>
            <path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/>
            <path d="M12 3v1M12 20v1M3 12h1M20 12h1"/>
          </svg>
        </div>
        <h3 class="cloud__feature-title" data-i18n="cloud.feature4.title">Deterministic failures</h3>
        <p class="cloud__feature-desc" data-i18n-html="cloud.feature4.desc">
          Clear reason codes — <code>blocked_unenrolled</code>, <code>auth_required</code>,
          <code>paused</code> — instead of silent drift. You know exactly what happened.
        </p>
      </div>
    </div>

    <!-- Quickstart terminal -->
    <div class="cloud__quickstart reveal reveal-delay-2">
      <div class="cloud__terminal">
        <div class="cloud__terminal-bar">
          <div class="cloud__terminal-dots" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <span class="cloud__terminal-title">quickstart</span>
        </div>
        <div class="cloud__terminal-body">
          <div class="cloud__code-line"><span class="cc-comment" data-i18n="cloud.terminal.comment1"># Start cloud + Postgres</span></div>
          <div class="cloud__code-line"><span class="cc-prompt">$</span> <span class="cc-cmd">docker compose -f docker-compose.cloud.yml up -d</span></div>
          <div class="cloud__code-line cloud__code-line--gap"><span class="cc-comment" data-i18n="cloud.terminal.comment2"># Configure & enroll</span></div>
          <div class="cloud__code-line"><span class="cc-prompt">$</span> <span class="cc-cmd">engram cloud config --server http://127.0.0.1:18080</span></div>
          <div class="cloud__code-line"><span class="cc-prompt">$</span> <span class="cc-cmd">engram cloud enroll my-project</span></div>
          <div class="cloud__code-line cloud__code-line--gap"><span class="cc-comment" data-i18n="cloud.terminal.comment3"># Sync & verify</span></div>
          <div class="cloud__code-line"><span class="cc-prompt">$</span> <span class="cc-cmd">engram sync --cloud --project my-project</span></div>
          <div class="cloud__code-line"><span class="cc-output" data-i18n="cloud.terminal.output">✓ pushed 42 observations to cloud</span></div>
        </div>
      </div>
    </div>

    <!-- Bottom CTA -->
    <div class="cloud__cta reveal reveal-delay-3">
      <p class="cloud__cta-text" data-i18n="cloud.cta.text">
        Local-first. Team-visible. Your infrastructure.
      </p>
      <div class="cloud__cta-actions">
        <a href="/engram-cloud/quickstart/" class="btn btn-primary btn-lg cloud__cta-btn">
          <span data-i18n="cloud.cta.primary">Deploy Engram Cloud</span>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2 8h12M10 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="/engram-cloud/what-is-cloud/" class="btn btn-secondary btn-lg" data-i18n="cloud.cta.secondary">
          Learn more
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  /* ===================================================
     ENGRAM CLOUD — Premium Product Section
     =================================================== */

  .cloud {
    position: relative;
    overflow: hidden;
    background: var(--bg-base);
    border-top: 1px solid var(--border-subtle);
  }

  /* ── Atmospheric backgrounds ─────────────────────── */

  .cloud__aurora {
    position: absolute;
    top: -200px;
    left: 50%;
    transform: translateX(-50%);
    width: 1400px;
    height: 600px;
    background:
      radial-gradient(ellipse 60% 50% at 30% 40%, rgba(234, 24, 137, 0.08) 0%, transparent 60%),
      radial-gradient(ellipse 50% 60% at 70% 50%, rgba(168, 20, 220, 0.06) 0%, transparent 55%);
    pointer-events: none;
    filter: blur(60px);
    animation: cloud-aurora 12s ease-in-out infinite alternate;
  }

  @keyframes cloud-aurora {
    0% { opacity: 0.7; transform: translateX(-50%) scale(1); }
    100% { opacity: 1; transform: translateX(-48%) scale(1.05); }
  }

  .cloud__orb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(80px);
  }

  .cloud__orb--1 {
    width: 400px;
    height: 400px;
    top: 30%;
    right: -10%;
    background: radial-gradient(ellipse, rgba(234, 24, 137, 0.12) 0%, transparent 70%);
    animation: cloud-float-1 8s ease-in-out infinite alternate;
  }

  .cloud__orb--2 {
    width: 300px;
    height: 300px;
    bottom: 10%;
    left: -5%;
    background: radial-gradient(ellipse, rgba(168, 20, 220, 0.08) 0%, transparent 70%);
    animation: cloud-float-2 10s ease-in-out infinite alternate;
  }

  @keyframes cloud-float-1 {
    0% { transform: translate(0, 0); }
    100% { transform: translate(-20px, 30px); }
  }

  @keyframes cloud-float-2 {
    0% { transform: translate(0, 0); }
    100% { transform: translate(15px, -20px); }
  }

  .cloud__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(234, 24, 137, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(234, 24, 137, 0.025) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, black, transparent);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, black, transparent);
    pointer-events: none;
  }

  /* ── Floating particles ─────────────────────────── */

 

  /* ── Hero area ──────────────────────────────────── */

  .cloud__hero {
    text-align: center;
    position: relative;
    z-index: 1;
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }

  .cloud__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 1rem;
    background: linear-gradient(135deg, rgba(234, 24, 137, 0.2), rgba(168, 20, 220, 0.15));
    border: 1px solid rgba(234, 24, 137, 0.35);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.5rem;
    box-shadow: 0 0 20px rgba(234, 24, 137, 0.15);
  }

  .cloud__badge-pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    animation: cloud-badge-pulse 1.8s ease-in-out infinite;
  }

  @keyframes cloud-badge-pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 10px var(--accent), 0 0 20px rgba(234, 24, 137, 0.3); }
    50% { opacity: 0.5; box-shadow: 0 0 4px var(--accent); }
  }

  .cloud__headline {
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .cloud__headline-line {
    display: block;
  }

  .cloud__sub {
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    color: var(--text-secondary);
    line-height: 1.75;
    max-width: 680px;
    margin-inline: auto;
  }

  /* ── Visual centerpiece ─────────────────────────── */

  .cloud__visual {
    position: relative;
    z-index: 1;
    margin-bottom: clamp(2rem, 5vw, 4rem);
    display: flex;
    justify-content: center;
  }

  .cloud__image-frame {
    position: relative;
    max-width: 600px;
    width: 100%;
  }

  .cloud__image-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 120%;
    height: 120%;
    background: radial-gradient(ellipse, rgba(234, 24, 137, 0.18) 0%, rgba(168, 20, 220, 0.08) 40%, transparent 70%);
    filter: blur(40px);
    pointer-events: none;
    animation: cloud-image-glow 4s ease-in-out infinite alternate;
  }

  @keyframes cloud-image-glow {
    0% { opacity: 0.6; }
    100% { opacity: 1; }
  }

  .cloud__image {
    width: 100%;
    height: auto;
    display: block;
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 0 40px rgba(234, 24, 137, 0.15));
    transition: filter 0.4s ease;
  }

  .cloud__image:hover {
    filter: drop-shadow(0 0 60px rgba(234, 24, 137, 0.25));
  }

  /* ── Architecture flow ──────────────────────────── */

  .cloud__arch {
    position: relative;
    z-index: 1;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .cloud__arch-flow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.5rem, 2vw, 1.5rem);
    padding: 2rem;
    background: rgba(17, 17, 19, 0.8);
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    backdrop-filter: blur(12px);
    overflow-x: auto;
  }

  .cloud__arch-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    min-width: 100px;
    text-align: center;
    flex-shrink: 0;
  }

  .cloud__arch-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    transition: all 0.3s ease;
  }

  .cloud__arch-icon--highlight {
    background: var(--accent-soft);
    border-color: rgba(234, 24, 137, 0.3);
    color: var(--accent);
    box-shadow: 0 0 20px rgba(234, 24, 137, 0.15);
  }

  .cloud__arch-icon--cloud {
    background: linear-gradient(135deg, rgba(234, 24, 137, 0.15), rgba(168, 20, 220, 0.12));
    border-color: rgba(234, 24, 137, 0.25);
    color: var(--accent);
  }

  .cloud__arch-label {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .cloud__arch-detail {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  .cloud__arch-detail--accent {
    color: var(--accent);
    font-weight: 600;
  }

  .cloud__arch-arrow {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .cloud__arch-arrow--opt {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .cloud__arch-opt-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* ── Feature pillars ────────────────────────────── */

  .cloud__features {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--border-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .cloud__feature {
    border-radius: 0;
    border: none;
    padding: 2rem 1.75rem;
    background: var(--bg-surface);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: background 0.3s ease;
  }

  .cloud__feature:hover {
    background: var(--bg-elevated);
    transform: none;
    box-shadow: none;
  }

  .cloud__feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--accent-soft);
    flex-shrink: 0;
  }

  .cloud__feature-icon::after {
    display: none;
  }

  .cloud__feature-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .cloud__feature-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .cloud__feature-desc code {
    font-family: var(--font-mono);
    font-size: 0.78em;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }

  /* ── Quickstart terminal ────────────────────────── */

  .cloud__quickstart {
    position: relative;
    z-index: 1;
    max-width: 680px;
    margin-inline: auto;
    margin-bottom: clamp(3rem, 6vw, 4rem);
  }

  .cloud__terminal {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--shadow-card), 0 0 60px rgba(234, 24, 137, 0.06);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .cloud__terminal:hover {
    border-color: rgba(234, 24, 137, 0.25);
    box-shadow: var(--shadow-card), 0 0 80px rgba(234, 24, 137, 0.1);
  }

  .cloud__terminal-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.25rem;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border-subtle);
  }

  .cloud__terminal-dots {
    display: flex;
    gap: 6px;
  }

  .cloud__terminal-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--text-muted);
    opacity: 0.3;
  }

  .cloud__terminal-dots span:first-child { background: #ff5f56; opacity: 0.7; }
  .cloud__terminal-dots span:nth-child(2) { background: #ffbd2e; opacity: 0.7; }
  .cloud__terminal-dots span:last-child { background: #27c93f; opacity: 0.7; }

  .cloud__terminal-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.03em;
  }

  .cloud__terminal-body {
    padding: 1.25rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.825rem;
    line-height: 1.9;
  }

  .cloud__code-line {
    white-space: nowrap;
    overflow-x: auto;
  }

  .cloud__code-line--gap {
    margin-top: 0.5rem;
  }

  .cc-prompt {
    color: var(--accent);
    margin-right: 0.5rem;
    user-select: none;
  }

  .cc-cmd {
    color: var(--text-primary);
  }

  .cc-comment {
    color: var(--text-muted);
  }

  .cc-output {
    color: #27c93f;
  }

  /* ── Bottom CTA ─────────────────────────────────── */

  .cloud__cta {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .cloud__cta-text {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    letter-spacing: -0.01em;
  }

  .cloud__cta-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cloud__cta-btn {
    box-shadow: var(--shadow-glow);
  }

  .cloud__cta-btn:hover {
    box-shadow: var(--shadow-glow-strong);
  }

  /* ── Responsive ─────────────────────────────────── */

  @media (max-width: 900px) {
    .cloud__features {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .cloud__features {
      grid-template-columns: 1fr;
    }

    .cloud__arch-flow {
      flex-direction: column;
      gap: 1rem;
      padding: 1.5rem;
    }

    .cloud__arch-arrow {
      transform: rotate(90deg);
    }

    .cloud__arch-arrow--opt {
      flex-direction: row;
      transform: rotate(90deg);
    }

    .cloud__terminal-body {
      font-size: 0.72rem;
      padding: 1rem;
    }

    .cloud__image-frame {
      max-width: 320px;
    }
  }
</style>
