        <a href="/getting-started/installation/" class="footer__link" data-i18n="footer.link.install">Installation</a>
        <a href="/agent-setup/" class="footer__link" data-i18n="footer.link.agents">Agent Setup</a>
        <a href="/features/" class="footer__link" data-i18n="footer.link.features">Features</a>
      </div>
      <div class="footer__col">
        <span class="footer__col-title" data-i18n="footer.col.learn">Learn</span>
        <a href="/architecture/" class="footer__link" data-i18n="footer.link.architecture">Architecture</a>
        <a href="/guides/" class="footer__link" data-i18n="footer.link.guides">Guides</a>
        <a href="/reference/" class="footer__link" data-i18n="footer.link.reference">Reference</a>
        <a href="/comparison/" class="footer__link" data-i18n="footer.link.comparison">Comparison</a>
      </div>
      <div class="footer__col">
        <span class="footer__col-title" data-i18n="footer.col.contribute">Contribute</span>
        <a href="https://github.com/Gentleman-Programming/engram" target="_blank" rel="noopener noreferrer" class="footer__link" data-i18n="footer.link.github">GitHub</a>
