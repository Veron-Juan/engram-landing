          <path d="M7 1v8M3 6l4 4 4-4M1 11h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <div class="lang-toggle" role="group" aria-label="Language selector" data-i18n-attr="aria-label:nav.languageLabel">
