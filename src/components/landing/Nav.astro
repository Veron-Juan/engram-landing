  const nav = document.getElementById('nav');
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');

  function applyLang(lang) {
    const messages = translations[lang] || translations.en;

    document.documentElement.lang = lang;

    document.querySelectorAll('[data-i18n]').forEach((el) => {
      const key = el.getAttribute('data-i18n');
      if (key && messages[key] !== undefined) el.textContent = messages[key];
    });

    document.querySelectorAll('[data-i18n-html]').forEach((el) => {
      const key = el.getAttribute('data-i18n-html');
      if (key && messages[key] !== undefined) el.innerHTML = messages[key];
    });

    document.querySelectorAll('[data-i18n-attr]').forEach((el) => {
      const value = el.getAttribute('data-i18n-attr');
      if (!value) return;
      const [attr, key] = value.split(':');
      if (attr && key && messages[key] !== undefined) {
        el.setAttribute(attr, messages[key]);
      }
    });

    document.querySelectorAll('.lang-btn').forEach((btn) => {
      const isActive = btn.getAttribute('data-lang') === lang;
      btn.classList.toggle('active', isActive);
      btn.setAttribute('aria-pressed', String(isActive));
    });

    window.dispatchEvent(new CustomEvent('engram:langchange', { detail: { lang } }));
  }

  window.addEventListener('scroll', () => {
    nav?.classList.toggle('scrolled', window.scrollY > 20);
  }, { passive: true });

  hamburger?.addEventListener('click', () => {
    const open = mobileMenu?.classList.toggle('open');
    hamburger.setAttribute('aria-expanded', String(open));
    mobileMenu?.setAttribute('aria-hidden', String(!open));
  });

  document.querySelectorAll('.lang-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const lang = btn.getAttribute('data-lang') || 'en';
      localStorage.setItem('engram-landing-lang', lang);
      applyLang(lang);
    });
  });

  applyLang(localStorage.getItem('engram-landing-lang') || 'en');
</script>
